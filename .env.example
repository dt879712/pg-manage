# --- Required ---
# Postgres connection string (e.g. Supabase). Use the pooler/hostname your host can reach.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
# Long random string used to sign auth tokens.
JWT_SECRET="change-me-to-a-long-random-value"

# --- Server ---
PORT=8080
# Comma-separated list of allowed browser origins, or * for all (default).
CORS_ORIGINS="*"
# Base URL used in password-reset links (your public site/app).
RESET_URL_BASE="https://app.example.com"

# --- Email (optional; if empty, reset links are logged/showed instead) ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
BREVO_API_KEY=""
MAIL_FROM="Dev Hostel <no-reply@example.com>"

# --- Push notifications (Expo) ---
EXPO_ACCESS_TOKEN=""

# --- File storage (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
