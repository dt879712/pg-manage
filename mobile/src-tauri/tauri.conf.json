{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Dev Hostel",
  "version": "1.0.2",
  "identifier": "com.devhostel.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": "npx expo start",
    "beforeBuildCommand": "npx expo export -p web"
  },
  "app": {
    "windows": [
      {
        "title": "Dev Hostel",
        "width": 1100,
        "height": 760,
        "minWidth": 420,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "category": "Business",
    "shortDescription": "Hostel & PG management",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}